# Copy to .env next to _passenger.cjs on the server (never in git).
# scripts/ensure-env.mjs creates the file if it is missing and adds new keys.
# Fill in the values and redeploy. Fields that are required and empty will stop the deploy.

# SMTP account that sends the email (not the public email address).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Envelope sender. Empty = SMTP_USER.
SMTP_FROM=

# Inbox for form submissions. The address is not shown on the site.
CONTACT_TO=

# Visit statistics. Empty ANALYTICS_DATABASE_URL = sqlite file (default, pure JS, no native module).
# mysql://user:pass@127.0.0.1:3306/mandalon_analytics for MariaDB.
ANALYTICS_DATABASE_URL=
ANALYTICS_SQLITE_PATH=./data/analytics.sqlite

# If country codes are wrong (data center instead of visitor):
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
