# Kopieras till .env bredvid _passenger.cjs på servern (aldrig i git).
# scripts/ensure-env.mjs skapar filen om den saknas och lägger till nya nycklar.
# Fyll i värdena och deploya om. Tomma obligatoriska nycklar stoppar deployen.

# SMTP-konto som skickar mejlet (inte den publika info@-adressen).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Avsändare i kuvertet. Tomt = SMTP_USER.
SMTP_FROM=

# Inkorg för formulär. Adressen syns inte på sajten.
CONTACT_TO=
