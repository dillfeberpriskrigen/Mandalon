# Kopieras till .env bredvid _passenger.cjs på servern (aldrig i git).
# scripts/ensure-env.mjs skapar filen om den saknas och lägger till nya nycklar.
# Fyll i värdena och deploya om. Tomma obligatoriska nycklar stoppar deployen.

# SMTP-konto som skickar mejlet (inte den publika info@-adressen).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Avsändare i kuvertet. Tomt = SMTP_USER.
SMTP_FROM=

# Inkorg för formulär. Adressen syns inte på sajten.
CONTACT_TO=

# Besöksstatistik. Tom ANALYTICS_DATABASE_URL = sqlite-fil (standard, ren JS, ingen native-modul).
# mysql://user:pass@127.0.0.1:3306/mandalon_analytics för MariaDB.
ANALYTICS_DATABASE_URL=
ANALYTICS_SQLITE_PATH=./data/analytics.sqlite

# Om landskoderna blir fel (datacenter i stället för besökare):
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
